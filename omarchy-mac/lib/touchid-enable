#!/bin/bash
# Turns Touch ID on once the owner has agreed: carves this Mac's calibration
# (and on the Neo its sensor root key) if they are missing, records the
# agreement so the driver loads at every boot, and loads it now.

tree=${OMARCHY_MAC_TOUCHID_TREE:-/proc/device-tree}
firmware=${OMARCHY_MAC_TOUCHID_FIRMWARE:-/usr/lib/firmware}
extractors=${OMARCHY_MAC_TOUCHID_EXTRACTORS:-/usr/lib/linux-aurora}
agreed=${OMARCHY_MAC_TOUCHID_AGREED:-/etc/omarchy-mac/touchid-on}
status_file=${OMARCHY_MAC_TOUCHID_STATUS:-/run/omarchy-mac/touchid}
helpers=${OMARCHY_MAC_TOUCHID_HELPERS:-/usr/lib/omarchy-mac}
node_path=${OMARCHY_MAC_TOUCHID_NODE:-/dev/sep-bio}
keybag=${OMARCHY_MAC_TOUCHID_KEYBAG:-/var/lib/aurora-sep-keybag.bin}
omarchy-hw-apple-silicon || exit 0

# Once this run records the agreement, a failure takes it back, so a Touch ID
# that never came up doesn't load at every boot and is offered again after a
# restart. A record from an earlier agreement stays.
recorded=0
fail() {
  if (( recorded )); then
    rm -f "$agreed"
  fi
  echo "Touch ID was not turned on: $1" >&2
  exit 1
}

installed() {
  local directory
  for directory in "$firmware" "$firmware/vendor" "$firmware/updates"; do
    if [[ -f $directory/$1 ]]; then
      return 0
    fi
  done
  return 1
}

eligibility=$("$helpers/touchid-eligibility")
[[ $eligibility == "available" ]] || fail "this Mac can't use it yet ($eligibility)"

# Factory data from this Mac's own iBoot System Container, never another's.
sensor=$("$helpers/touchid-eligibility" sensor)
calibration=apple/mesa_calibration.bin
if [[ -r $sensor/firmware-name ]]; then
  calibration=$(tr -d '\0' <"$sensor/firmware-name")
fi
if ! installed "$calibration"; then
  echo "Copying this Mac's Touch ID calibration..."
  mkdir -p -m 0755 "$firmware/updates/${calibration%/*}"
  "$extractors/extract-mesa-calibration" -o "$firmware/updates/$calibration" >/dev/null ||
    fail "this Mac's calibration could not be read"
  chmod 0644 "$firmware/updates/$calibration"
fi
if tr '\0' '\n' <"$tree/compatible" | grep -Fxq apple,t8140 && ! installed apple/msrk-j700.bin; then
  echo "Copying this Mac's Touch ID sensor key..."
  mkdir -p -m 0755 "$firmware/updates/apple"
  (umask 077 && "$extractors/extract-sensor-root-key" -o "$firmware/updates/apple/msrk-j700.bin" >/dev/null) ||
    fail "this Mac's sensor key could not be read"
  chmod 0600 "$firmware/updates/apple/msrk-j700.bin"
fi

# The record is the agreement: omarchy-mac-touchid-load.service loads the
# driver at every boot while it exists, and disable-fingerprint removes it.
mkdir -p -m 0755 "${agreed%/*}"
[[ -e $agreed ]] || recorded=1
printf '%s\n' "# The owner turned on Touch ID; omarchy-mac's disable-fingerprint removes this." >"$agreed"
chmod 0644 "$agreed"
modprobe apple-sep || fail "the Secure Enclave driver did not load"

# The node and keybag appear a few seconds after the driver binds. Their add
# event starts the activation; starting it here too waits for its answer.
echo "Starting Touch ID..."
for ((attempt = 0; attempt < 200; attempt++)); do
  if [[ -e $node_path && -e $keybag ]]; then
    break
  fi
  sleep 0.1
done
systemctl start omarchy-mac-touchid-activate.service 2>/dev/null
if [[ $(cat "$status_file" 2>/dev/null) == "ready" ]]; then
  # An fprintd that started without the reader found none and kept no
  # allowance for its node, so it starts again with both.
  systemctl try-restart fprintd.service 2>/dev/null
  echo "Touch ID is on."
else
  fail "it did not become ready ($(cat "$status_file" 2>/dev/null || echo unknown)); see journalctl -u omarchy-mac-touchid-activate. The driver stays loaded until this Mac restarts; restart before trying again"
fi
