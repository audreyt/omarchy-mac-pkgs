# Records at boot whether Touch ID can be set up, before anything loads the
# Secure Enclave driver, so Omarchy can ask the owner (fingerprint-readers
# names the record). Pulled in by the package's multi-user.target.wants link.
[Unit]
Description=Check whether Touch ID can be set up
After=local-fs.target systemd-modules-load.service
Before=display-manager.service fprintd.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/omarchy-hw-apple-silicon
ExecStart=/usr/lib/omarchy-mac/touchid-status
TimeoutStartSec=30s
